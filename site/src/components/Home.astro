---
/**
 * @file Home.astro
 * @description Home page, in either language: what Musonic is and where to click, a large real
 *   screenshot, a word for people a relative set it up for, then one row per part (app, web,
 *   server) and the benchmark in one sentence.
 * @author DoodzProg
 * @version 0.2.0
 * @license CC-BY-NC-4.0
 */
import Base from './Base.astro';
import { localePath, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const L = (p: string) => localePath(p, lang);
const apk = 'https://github.com/DoodzDev/Musonic/releases/latest/download/Musonic.apk';

const t = {
  en: {
    title: 'Musonic: your server, your data, your music',
    description: 'A music app for Android and iOS, a web player and a server that runs at home. No ads, no subscription.',
    h1: 'Your server, your data. And your music.',
    lead: 'An app for Android and iOS, a player in the browser and a server that runs at home. No ads, no subscription, and you can add your own files, even songs no platform has.',
    download: 'Download for Android',
    ios: 'iOS (manual install)',
    tryWeb: 'Try it in the browser',
    installServer: 'Install the server',
    fine: 'Free · public code · non-commercial licence',
    shotAlt: 'The Musonic web player: home page with recently played albums and favourite artists.',
    noteTitle: 'Someone installed Musonic for you?',
    note: 'There is nothing more to learn: they look after the server, and the app works like the other music apps. Coming from Spotify or Deezer? Import your playlists from the Library. One thing is different: updates do not come from the Play Store or the App Store. The app tells you when one is out and gives you the link.',
    rows: [
      { img: '/assets/img/screenshots/landscape_home.jpg', alt: 'The Musonic app in landscape: home page.', h: 'The app on your phone', p: 'Synced lyrics, mixes built from what you listen to, crossfade, podcasts, downloads for places without signal, and Android Auto in the car.', link: ['About the app', '/mobile/'] },
      { img: '/assets/img/screenshots/web/album-en.jpg', alt: 'Musonic in a browser: an album page.', h: 'In your browser', p: 'The same home, mixes, lyrics and playlists on a big screen, nothing to install. Import your Spotify, Deezer and YouTube Music playlists from a link.', link: ['Open the web player', '/app/'] },
      { img: '/assets/img/screenshots/console/dashboard-en.jpg', alt: 'The administration console of Musonic Server: dashboard.', h: 'The server, at home', p: 'Your files stay on your disk. Accounts for your family and friends, podcasts, devices that pass the music to each other (Musonic Connect, beta), and a console to run it all.', link: ['About the server', '/server/'] },
    ],
    proof: ['10× faster', ' than Navidrome to scan a library: 1.8 s instead of 18.9 s on the same machine. I measured 36 things, including the few where Navidrome is ahead.'],
    proofLink: 'See the benchmark',
  },
  fr: {
    title: 'Musonic : votre serveur, vos données, ta musique',
    description: 'Une appli de musique Android et iOS, un lecteur web et un serveur qui tourne chez vous. Pas de pub, pas d\'abonnement.',
    h1: 'Votre serveur, vos données. Et ta musique.',
    lead: 'Une appli Android et iOS, un lecteur web et un serveur qui tourne chez vous. Pas de pub, pas d\'abonnement, et vous pouvez ajouter vos propres fichiers, même les chansons qu\'aucune plateforme n\'a.',
    download: 'Télécharger pour Android',
    ios: 'iOS (installation manuelle)',
    tryWeb: 'Essayer dans le navigateur',
    installServer: 'Installer le serveur',
    fine: 'Gratuit · code public · licence non commerciale',
    shotAlt: 'Le lecteur web de Musonic : l\'accueil avec les albums écoutés récemment et les artistes préférés.',
    noteTitle: 'Un proche vous a installé Musonic ?',
    note: 'Vous n\'avez rien de plus à savoir : c\'est lui qui s\'occupe du serveur, et l\'appli s\'utilise comme les autres. Vous venez de Spotify ou de Deezer ? Importez vos playlists depuis la Bibliothèque. Une seule chose change : les mises à jour ne passent ni par le Play Store ni par l\'App Store. L\'appli vous prévient et vous donne le lien.',
    rows: [
      { img: '/assets/img/screenshots/landscape_home.jpg', alt: 'L\'appli Musonic en paysage : l\'accueil.', h: 'L\'appli sur votre téléphone', p: 'Paroles synchronisées, mix construits à partir de ce que vous écoutez, fondu entre les titres, podcasts, téléchargements pour les endroits sans réseau, et Android Auto en voiture.', link: ['Découvrir l\'appli', '/mobile/'] },
      { img: '/assets/img/screenshots/web/album-fr.jpg', alt: 'Musonic dans un navigateur : une page d\'album.', h: 'Dans votre navigateur', p: 'Le même accueil, les mêmes mix, paroles et playlists sur un grand écran, rien à installer. Importez vos playlists Spotify, Deezer et YouTube Music depuis un lien.', link: ['Ouvrir le lecteur web', '/app/'] },
      { img: '/assets/img/screenshots/console/dashboard-fr.jpg', alt: 'La console d\'administration de Musonic Server : le tableau de bord.', h: 'Le serveur, chez vous', p: 'Vos fichiers restent sur votre disque. Des comptes pour votre famille et vos amis, des podcasts, des appareils qui se passent la musique (Musonic Connect, bêta), et une console pour tout gérer.', link: ['Découvrir le serveur', '/server/'] },
    ],
    proof: ['10× plus rapide', ' que Navidrome pour analyser une bibliothèque : 1,8 s au lieu de 18,9 s sur la même machine. J\'ai mesuré 36 choses, y compris les quelques-unes où Navidrome est devant.'],
    proofLink: 'Voir le benchmark',
  },
}[lang];
const homeShot = `/assets/img/screenshots/web/home-${lang}.jpg`;
---
<Base lang={lang} path="/" title={t.title} description={t.description}>
  {lang === 'en' && (
    <script slot="head" is:inline>
      // First visit of the English home page from a French browser: go to the French one.
      // A language picked by hand (EN/FR link) is remembered and always wins.
      try {
        var chosen = localStorage.getItem('musonic-lang');
        if (chosen === 'fr' || (!chosen && /^fr\b/i.test(navigator.language || ''))) location.replace('/fr/');
      } catch (e) {}
    </script>
  )}
  <section class="wrap hero">
    <h1>{t.h1}</h1>
    <p class="lead">{t.lead}</p>
    <div class="actions">
      <a class="button" href={apk}>{t.download}</a>
      <a class="button button--second" href="/app/">{t.tryWeb}</a>
      <div class="textlinks">
        <a href={L('/mobile/') + '#ios'}>{t.ios}</a>
        <a href={L('/docs/install/docker/')}>{t.installServer}</a>
      </div>
    </div>
    <p class="small">{t.fine}</p>
    <img class="shot" src={homeShot} alt={t.shotAlt} width="1600" height="1000" />
  </section>

  <section class="wrap block note">
    <h2>{t.noteTitle}</h2>
    <p>{t.note}</p>
  </section>

  <section class="wrap">
    {t.rows.map((r) => (
      <div class="row">
        <img class="row__img" src={r.img} alt={r.alt} loading="lazy" />
        <div>
          <h3>{r.h}</h3>
          <p>{r.p}</p>
          <a href={r.link[1] === '/app/' ? '/app/' : L(r.link[1])}>{r.link[0]} →</a>
        </div>
      </div>
    ))}
  </section>

  <section class="wrap block">
    <p class="figure"><strong>{t.proof[0]}</strong>{t.proof[1]}</p>
    <a href={L('/about/') + '#benchmark'}>{t.proofLink} →</a>
  </section>
</Base>
