+package com.doublesymmetry.trackplayer.service
+
+import android.os.Bundle
+import android.support.v4.media.session.PlaybackStateCompat
+import androidx.annotation.MainThread
+import com.google.android.exoplayer2.Player
+import com.google.android.exoplayer2.ext.mediasession.MediaSessionConnector
+
+/**
+ * Musonic: extra buttons on the media session (shuffle, repeat, like), shown by Android Auto
+ * on its playback screen. They are added to KotlinAudio's own custom actions, which it
+ * rewrites when the notification is (re)created; the app sends them again on every change.
+ */
+@MainThread
+object MusonicCustomActions {
+    class Action(val name: String, val label: String, val icon: Int)
+
+    private var connector: MediaSessionConnector? = null
+    private var actions: List<Action> = emptyList()
+
+    /** Called with the action name when one of the buttons is pressed. */
+    var onAction: ((String) -> Unit)? = null
+
+    fun attach(connector: MediaSessionConnector) {
+        this.connector = connector
+        apply()
+    }
+
+    fun detach() {
+        connector = null
+    }
+
+    fun set(actions: List<Action>) {
+        this.actions = actions
+        apply()
+    }
+
+    private fun apply() {
+        val target = connector ?: return
