+package com.doublesymmetry.trackplayer.service
+
+import android.support.v4.media.session.MediaSessionCompat
+import androidx.annotation.MainThread
+import com.doublesymmetry.kotlinaudio.players.BaseAudioPlayer
+
+/**
+ * Musonic: shares the player's media session token with the app's Android Auto browser
+ * service, so the car drives the same session as the notification and the lock screen.
+ * KotlinAudio keeps the session private, hence the reflection (R8 is disabled in the app).
+ */
+@MainThread
+object MediaSessionTokenHolder {
+    private val listeners = mutableListOf<(MediaSessionCompat.Token) -> Unit>()
+
+    var token: MediaSessionCompat.Token? = null
+        private set
+
+    /**
+     * Set by the app when Android Auto wakes Musonic while it is closed: the player may then
+     * be set up without a screen (read from the React Native module thread).
+     */
+    @Volatile
+    var startedByCar = false
+
+    fun publishFrom(player: BaseAudioPlayer) {
+        val field = BaseAudioPlayer::class.java.getDeclaredField("mediaSession")
+        field.isAccessible = true
+        val session = field.get(player) as MediaSessionCompat
+        token = session.sessionToken
+        listeners.toList().forEach { it(session.sessionToken) }
+    }
+
+    fun clear() {
+        token = null
+    }
+
+    fun addListener(listener: (MediaSessionCompat.Token) -> Unit) {
+        listeners.add(listener)
+    }
+
+    fun removeListener(listener: (MediaSessionCompat.Token) -> Unit) {
+        listeners.remove(listener)
+    }
+}
